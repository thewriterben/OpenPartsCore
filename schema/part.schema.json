{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openpartscore/part.schema.json",
  "title": "Part",
  "description": "One canonical part entry. Length fields are millimetres and end in _mm; other units are named in the field key.",
  "type": "object",
  "required": ["schema_version", "id", "namespace", "name", "source"],
  "properties": {
    "schema_version": { "const": 0 },
    "id": {
      "type": "string",
      "description": "Stable id, '<namespace>/<slug>'",
      "pattern": "^(boards|electronic|mechanical|material)/[a-z0-9][a-z0-9._-]*$"
    },
    "namespace": { "enum": ["boards", "electronic", "mechanical", "material"] },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "source": {
      "type": "object",
      "description": "Where every value in this entry comes from. Uncited entries are invalid.",
      "required": ["citation"],
      "properties": {
        "citation": { "type": "string", "minLength": 1 },
        "retrieved": { "type": "string", "format": "date" },
        "upstream_schema_version": { "type": ["integer", "string"] },
        "note": { "type": "string", "description": "How the cited bytes yield the values: method, page, container, caveats. It explains the citation and never replaces it." }
      }
    },
    "attributes": {
      "type": "object",
      "description": "Namespace-specific facts, preserved verbatim from the cited source."
    },
    "envelope_mm": {
      "type": "object",
      "description": "Axis-aligned bounding envelope of the physical part, millimetres. Carries its own source because it almost never comes from the same document as the rest of the entry (ADR-0006). Absent means unknown, never zero.",
      "required": ["x", "y", "z", "source"],
      "properties": {
        "x": { "type": "number", "exclusiveMinimum": 0 },
        "y": { "type": "number", "exclusiveMinimum": 0 },
        "z": { "type": "number", "exclusiveMinimum": 0 },
        "tolerance_mm": { "type": "number", "exclusiveMinimum": 0, "description": "Dimensional tolerance if the source states one." },
        "source": {
          "type": "object",
          "required": ["citation"],
          "properties": {
            "citation": { "type": "string", "minLength": 1 },
            "url": { "type": "string" },
            "retrieved": { "type": "string", "format": "date" },
            "note": { "type": "string", "description": "How the cited bytes yield the values: method, page, container, caveats. It explains the citation and never replaces it." }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "description": "Where things are on the part: connectors, switches, bodies, and the volume each needs kept free (ADR-0008). Carries its own source and the hardware revision it describes. Absent means undescribed, never clear.",
      "required": ["source", "frame", "not_modelled", "items"],
      "properties": {
        "source": {
          "type": "object",
          "required": ["citation", "model_sha256", "revision"],
          "properties": {
            "citation": { "type": "string", "minLength": 1 },
            "model_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "revision": { "type": "string", "minLength": 1 },
            "note": { "type": "string", "description": "How the cited model yields the positions: tool, version, method, caveats. It explains the citation and never replaces it." },
            "url": { "type": "string" },
            "retrieved": { "type": "string", "format": "date" }
          },
          "additionalProperties": false
        },
        "frame": { "type": "string", "minLength": 1, "description": "Origin and axes of every coordinate below, in words. Millimetres." },
        "not_modelled": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Regions of the physical part the items do not describe. A clearance check must report these."
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/feature" }
        }
      },
      "additionalProperties": false
    },
    "links": {
      "type": "object",
      "properties": {
        "datasheet": { "type": "string" },
        "kicad_footprint": { "type": "string" },
        "kicad_symbol": { "type": "string" },
        "atopile_package": { "type": "string" },
        "model_3d": { "type": "string", "description": "Path or content hash of a STEP/3MF model" }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "vec3_mm": {
      "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3
    },
    "axis": { "enum": ["+x", "-x", "+y", "-y", "+z", "-z"] },
    "feature": {
      "type": "object",
      "required": ["id", "kind", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["board", "connector", "switch", "card_slot", "antenna", "optic", "component"] },
        "box_mm": {
          "type": "object",
          "required": ["min_mm", "max_mm"],
          "properties": { "min_mm": { "$ref": "#/$defs/vec3_mm" }, "max_mm": { "$ref": "#/$defs/vec3_mm" } },
          "additionalProperties": false
        },
        "cylinder_mm": {
          "type": "object",
          "description": "Axis-aligned cylinder: base_mm is the centre of the face it starts from; it extends length_mm along axis.",
          "required": ["axis", "base_mm", "length_mm", "diameter_mm"],
          "properties": {
            "axis": { "$ref": "#/$defs/axis" },
            "base_mm": { "$ref": "#/$defs/vec3_mm" },
            "length_mm": { "type": "number", "exclusiveMinimum": 0 },
            "diameter_mm": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        },
        "source": { "type": "string", "minLength": 1, "description": "'step:<solid name>' or the measurement, with date and instrument." },
        "access": {
          "type": "object",
          "description": "Volume that must stay free for a plug, card or finger, extruded from the item's face on the direction side. null direction or depth means unknown: consumers report the item as unverified.",
          "required": ["direction", "depth_mm", "source"],
          "properties": {
            "direction": { "oneOf": [{ "$ref": "#/$defs/axis" }, { "type": "null" }] },
            "depth_mm": { "oneOf": [{ "type": "number", "exclusiveMinimum": 0 }, { "type": "null" }] },
            "section_mm": {
              "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 }, "minItems": 2, "maxItems": 2,
              "description": "Cross-section perpendicular to direction, centred on the item's face, in the order of the remaining axes x,y,z. Absent means the item's own face."
            },
            "source": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "oneOf": [{ "required": ["box_mm"] }, { "required": ["cylinder_mm"] }],
      "additionalProperties": false
    }
  }
}
